# Git identity - used by .devcontainer/post-create.sh to configure Git.
GITHUB_NAME=Your Name
GITHUB_EMAIL=your-id+handle@users.noreply.github.com

# PostgreSQL connection string for database-backed CLI workflows and Sqitch.
# Copy this file to .env and replace the placeholder values with local secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
